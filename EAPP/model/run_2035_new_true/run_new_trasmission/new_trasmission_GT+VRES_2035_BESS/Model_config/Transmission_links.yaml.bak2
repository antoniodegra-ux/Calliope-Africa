# Transmission Grid and the connections Definition #

# Parameters and Units:

    # energy_cap_equals:  Capacity of Grid          [kW]
    # distance:           Distance Between 2 Nodes  [hundreds of km]   

techs:


############################### High Voltage Direct Current 132 kV ############################### 
    132_kV:
        essentials:
            name: '132_kV'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076

############################### High Voltage Direct Current 220 kV ############################### 
    220_kV:
        essentials:
            name: '220_kV'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076

############################### High Voltage Direct Current 400 kV ############################### 
    400_kV:
        essentials:
            name: '400_kV'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076

  ############################### High Voltage Direct Current 500 kV ############################### 
    500_kV:
        essentials:
            name: '500_kV'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076
  ############################### transmission_2030_installed ############################### 
    transmission_2030_installed:
        essentials:
            name: 'transmission_2030_installed'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076
    transmission_2035_installed:
        essentials:
            name: 'transmission_2035_installed'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076
    transmission_2040_installed:
        essentials:
            name: 'transmission_2040_installed'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.965
        costs:
            monetary:
                om_prod: 0.0076
  ############################### new transmission ############################### 
    new_transmission:
        essentials:
            name: 'new_transmission'
            parent: transmission
            carrier: electricity
            color: '#00BFFF'
        constraints:
            energy_eff_per_distance: 0.993
            lifetime: 40
        costs:
            monetary:
                energy_cap: 17.35
                energy_cap_per_distance: 331.8
                om_prod: 0.0076
                interest_rate: 0.10

links:
# Connection of Nodes
# As the country is divided into 4 regions, the distance and capacity between two nodes could be different in different directions
# due to the fact that there are different counties are located in every region and not all of them are connected
# As a result, an average capacity and distance is considered for the connection of every two nodes.
    Burundi,DRC_E:
        techs:
            220_kV:
                constraints:
                    energy_cap_equals: 4000
                distance: 0.778 #100 km  
            new_transmission:
                constraints:
                    energy_cap_max: inf
                distance: 0.778 #100 km                                                                
            transmission_2030_installed:
                constraints:
                    energy_cap_equals: 145000
                distance: 0.778 #100 km                 

